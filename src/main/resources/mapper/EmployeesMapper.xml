<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- namespace : 연결할 맵퍼 인터페이스 패키지 작성해주는 속성 -->
<mapper namespace="com.msa4spring.mappers.EmployeeMapper">
    <!-- ResultMap : 특정 Entity 객체와 연결 -->
    <resultMap id="employeeResultMap" type="com.msa4spring.entities.Employee">

        <!-- column : DB 컬럼 명
        , property : entities.Employee.java에서 지정한 속성 값 -->
        <id column="emp_id" property="empId" />   <!-- PK인 id만 따로 지정 -->
        <result column="name" property="name" />
        <result column="birth" property="birth" />
        <result column="gender" property="gender" />
        <result column="hire_at" property="hireAt" />
        <result column="fire_at" property="fireAt" />
        <result column="sup_id" property="supId" />
        <result column="created_at" property="createdAt" />
        <result column="updated_at" property="updatedAt" />
        <result column="deleted_at" property="deletedAt" />
    </resultMap>


    <!-- 쿼리문 -->
    <!-- id : EmployeeMapper 인터페이스 안에도 넣어줘야 함. -->
    <select id="getEmployees" resultMap="employeeResultMap">
        SELECT *
        FROM employees
        WHERE
            deleted_at IS NULL
        LIMIT 5
    </select>


    <select id="findByPk" resultMap="employeeResultMap">
        SELECT
            *
        FROM employees
        WHERE
                deleted_at IS NULL
            AND emp_id = #{empId}
    </select>


    <insert
            id="store"
            parameterType="com.msa4spring.entities.Employee"
            keyProperty="empId"
            useGeneratedKeys="true"
    >
            INSERT INTO employees(
                name
                ,birth
                ,gender
                ,hire_at
            ) VALUES (
                #{name}
                ,#{birth}
                ,#{gender}
                ,NOW()
            )
    </insert>


</mapper>